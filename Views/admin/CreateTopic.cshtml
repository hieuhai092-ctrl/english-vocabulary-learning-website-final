@model English_Vocabulary_Learning_Website.Models.Topic
@{
    ViewBag.Title = "Thêm chủ đề mới - Admin";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .create-card {
        background-color: #1e293b;
        border: 1px solid #334155;
        border-radius: 20px;
        padding: 32px;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.35);
    }

    .gradient-heading {
        background: linear-gradient(to right, #34d399, #38bdf8);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-weight: 800;
    }

    .form-label-dark {
        color: #cbd5e1;
        font-weight: 600;
        font-size: 0.92rem;
        margin-bottom: 8px;
    }

    .input-dark {
        background-color: #0f172a !important;
        border: 1px solid #334155 !important;
        color: #f8fafc !important;
        border-radius: 12px !important;
        padding: 12px 16px;
        transition: all 0.25s ease;
    }

        .input-dark:focus {
            border-color: #34d399 !important;
            box-shadow: 0 0 0 3px rgba(52, 211, 153, 0.2) !important;
        }

    .preview-box {
        background-color: #0f172a;
        border: 1.5px dashed #475569;
        border-radius: 16px;
        height: 200px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .preview-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .btn-save-topic {
        background: linear-gradient(135deg, #10b981, #059669);
        border: none;
        color: #fff;
        font-weight: 700;
        border-radius: 50px;
        padding: 11px 32px;
        box-shadow: 0 6px 18px rgba(16, 185, 129, 0.35);
        transition: all 0.25s ease;
    }

        .btn-save-topic:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 24px rgba(16, 185, 129, 0.5);
            color: #fff;
        }
</style>

<div class="container py-4 pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="create-card">
                <div class="mb-4">
                    <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50 px-3 py-1 rounded-pill mb-2">
                        ➕ Quản trị nội dung
                    </span>
                    <h2 class="gradient-heading mb-1">Thêm chủ đề học tập mới</h2>
                    <p class="text-secondary small mb-0">Tạo chủ đề mới để bổ sung danh sách từ vựng Flashcard và câu hỏi trắc nghiệm</p>
                </div>

                @using (Html.BeginForm("CreateTopic", "Admin", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label-dark">Tên chủ đề <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.Name, new { @class = "form-control input-dark", placeholder = "Ví dụ: Business, Food & Drinks, Education...", required = "required" })
                        @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label-dark">Mô tả ngắn</label>
                        @Html.TextAreaFor(m => m.Description, new { @class = "form-control input-dark", rows = "3", placeholder = "Nhập mô tả nội dung chính của chủ đề này..." })
                    </div>

                    <div class="mb-3">
                        <label class="form-label-dark">Đường dẫn hình ảnh (Image URL)</label>
                        @Html.TextBoxFor(m => m.ImageUrl, new { @class = "form-control input-dark", id = "imageUrlInput", placeholder = "Dán link ảnh (https://...) tại đây..." })
                        <small class="text-secondary">Mẹo: Chuột phải vào ảnh trên mạng chọn "Sao chép địa chỉ hình ảnh" rồi dán vào đây.</small>
                    </div>

                    <div class="mb-4">
                        <label class="form-label-dark d-block">Xem trước ảnh bìa</label>
                        <div class="preview-box">
                            <img id="imagePreview" src="https://images.unsplash.com/photo-1456513080510-7bf3a84b82f8?auto=format&fit=crop&w=600&q=80" alt="Preview" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-2">
                        <a href="@Url.Action("Index", "Admin")" class="btn btn-outline-secondary rounded-pill px-4">
                            ⬅️ Quay lại
                        </a>
                        <button type="submit" class="btn btn-save-topic">
                            💾 Lưu chủ đề
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

