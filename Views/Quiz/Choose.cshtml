
@model IEnumerable<English_Vocabulary_Learning_Website.Models.Topic>

@{
    ViewBag.Title = "Chọn chủ đề kiểm tra";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="text-center fw-bold text-success mb-4">CHỌN CHỦ ĐỀ ĐỂ KIỂM TRA</h2>

<div class="row">
    @foreach (var topic in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                @if (!string.IsNullOrEmpty(topic.ImageUrl))
                {
                    <img src="@topic.ImageUrl" class="card-img-top" alt="@topic.Name" style="height: 160px; object-fit: cover;" />
                }
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@topic.Name</h5>
                    <p class="card-text text-muted">@topic.Description</p>
                    <div class="mt-auto d-flex justify-content-between align-items-center">
                        <span class="small text-secondary">@topic.Quizzes.Count câu hỏi</span>
                        <a href="@Url.Action("Index", "Quiz", new { topicId = topic.Id })" class="btn btn-success btn-sm">Làm Quiz</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
