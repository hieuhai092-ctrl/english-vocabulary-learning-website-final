@model IEnumerable<English_Vocabulary_Learning_Website.Models.Quiz>
@{
    ViewBag.Title = "Bài kiểm tra trắc nghiệm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Banner tiêu đề bài kiểm tra */
    .quiz-hero-box {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 60%, #064e3b 100%);
        border: 1px solid rgba(52, 211, 153, 0.25);
        border-radius: 20px;
        padding: 28px 32px;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
    }

    .quiz-gradient-title {
        background: linear-gradient(to right, #34d399, #38bdf8);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-weight: 800;
    }

    /* Card từng câu hỏi */
    .question-card-modern {
        background-color: #1e293b;
        border: 1px solid #334155;
        border-radius: 20px;
        padding: 26px 28px;
        margin-bottom: 24px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
        transition: border-color 0.3s ease;
    }

        .question-card-modern:hover {
            border-color: rgba(52, 211, 153, 0.45);
        }

    .question-badge {
        background: rgba(245, 158, 11, 0.15);
        color: #fbbf24;
        border: 1px solid rgba(245, 158, 11, 0.35);
        padding: 4px 12px;
        border-radius: 50px;
        font-size: 0.82rem;
        font-weight: 700;
        display: inline-block;
        margin-bottom: 10px;
    }

    .question-title-text {
        color: #f8fafc;
        font-size: 1.15rem;
        font-weight: 700;
        line-height: 1.5;
        margin-bottom: 18px;
    }

    /* Thẻ đáp án bấm được toàn vùng */
    .option-card-label {
        display: flex;
        align-items: center;
        gap: 14px;
        background-color: #0f172a;
        border: 1.5px solid #334155;
        border-radius: 14px;
        padding: 13px 18px;
        margin-bottom: 12px;
        cursor: pointer;
        color: #cbd5e1;
        font-weight: 500;
        transition: all 0.2s ease;
        user-select: none;
    }

        .option-card-label:hover {
            border-color: #38bdf8;
            background-color: rgba(56, 189, 248, 0.06);
            color: #ffffff;
            transform: translateX(4px);
        }

        .option-card-label:has(input:checked),
        .option-card-label.selected-option {
            background: rgba(16, 185, 129, 0.14);
            border-color: #34d399;
            color: #ffffff;
            box-shadow: 0 4px 14px rgba(16, 185, 129, 0.2);
        }

    .option-letter-badge {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background-color: #1e293b;
        border: 1px solid #475569;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.9rem;
        color: #94a3b8;
        flex-shrink: 0;
        transition: all 0.2s ease;
    }

    .option-card-label:has(input:checked) .option-letter-badge,
    .option-card-label.selected-option .option-letter-badge {
        background-color: #10b981;
        border-color: #10b981;
        color: #ffffff;
    }

    .option-radio {
        accent-color: #10b981;
        width: 18px;
        height: 18px;
        cursor: pointer;
        margin-left: auto;
    }

    /* Nút nộp bài */
    .btn-submit-quiz {
        background: linear-gradient(135deg, #10b981, #059669);
        border: none;
        color: #ffffff;
        font-weight: 700;
        font-size: 1.05rem;
        border-radius: 50px;
        padding: 13px 48px;
        box-shadow: 0 8px 24px rgba(16, 185, 129, 0.35);
        transition: all 0.25s ease;
    }

        .btn-submit-quiz:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 30px rgba(16, 185, 129, 0.55);
            color: #ffffff;
        }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <!-- Header bài kiểm tra -->
            <div class="quiz-hero-box mb-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div>
                    <span class="badge bg-warning bg-opacity-15 text-warning border border-warning border-opacity-25 px-3 py-1 rounded-pill mb-2">
                        ⏱️ Thử thách trí nhớ từ vựng
                    </span>
                    <h2 class="quiz-gradient-title mb-1">BÀI KIỂM TRA TRẮC NGHIỆM</h2>
                    <p class="text-light opacity-75 small mb-0">Chọn 1 đáp án chính xác nhất cho mỗi câu hỏi bên dưới</p>
                </div>
                <div>
                    <span class="badge bg-dark border border-secondary px-3 py-2 rounded-pill fs-6">
                        Đã làm: <span id="answeredCount" class="text-success fw-bold">0</span> / <span>@Model.Count()</span>
                    </span>
                </div>
            </div>

            <form action="@Url.Action("Submit", "Quiz", new { topicId = ViewBag.TopicId })" method="post">
                @{ int index = 1; }
                @foreach (var question in Model)
                {
                    <div class="question-card-modern">
                        <span class="question-badge">Câu @(index++)</span>
                        <h5 class="question-title-text">@question.Question</h5>

                        <div class="options-group mt-2">
                            <!-- Đáp án A -->
                            <label class="option-card-label" for="optA_@question.Id">
                                <span class="option-letter-badge">A</span>
                                <span>@question.OptionA</span>
                                <input class="option-radio quiz-radio" type="radio" name="question_@question.Id" id="optA_@question.Id" value="A" required>
                            </label>

                            <!-- Đáp án B -->
                            <label class="option-card-label" for="optB_@question.Id">
                                <span class="option-letter-badge">B</span>
                                <span>@question.OptionB</span>
                                <input class="option-radio quiz-radio" type="radio" name="question_@question.Id" id="optB_@question.Id" value="B">
                            </label>

                            <!-- Đáp án C -->
                            <label class="option-card-label" for="optC_@question.Id">
                                <span class="option-letter-badge">C</span>
                                <span>@question.OptionC</span>
                                <input class="option-radio quiz-radio" type="radio" name="question_@question.Id" id="optC_@question.Id" value="C">
                            </label>

                            <!-- Đáp án D -->
                            <label class="option-card-label mb-0" for="optD_@question.Id">
                                <span class="option-letter-badge">D</span>
                                <span>@question.OptionD</span>
                                <input class="option-radio quiz-radio" type="radio" name="question_@question.Id" id="optD_@question.Id" value="D">
                            </label>
                        </div>
                    </div>
                }

                <div class="text-center mt-4">
                    <button type="submit" class="btn btn-submit-quiz shadow">
                        ✅ Nộp bài
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
