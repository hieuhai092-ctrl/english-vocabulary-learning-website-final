@model IEnumerable<English_Vocabulary_Learning_Website.Models.Vocabulary>

@{
    ViewBag.Title = "Học Flashcard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var vocabJson = Model != null
        ? Json.Encode(Model.Select(v => new
        {
            word = v.Word,
            phonetic = v.Pronunciation ?? "",
            meaning = v.Meaning,
            example = v.Example ?? ""
        }))
        : "[]";
}

<div class="container my-5 text-center">
    <h2 class="fw-bold mb-2">Học Từ Vựng Theo Thẻ (Flashcard)</h2>

    @if (ViewBag.Topic != null)
    {
        <h4 class="text-muted mb-4">Chủ đề: @ViewBag.Topic.Name</h4>
    }

    @if (Model != null && Model.Any())
    {
        <!-- Khung Flashcard 3D -->
        <div class="flashcard-wrapper my-4">
            <div class="flashcard-inner" id="flashcard">
                <!-- Mặt trước (Từ vựng + Phiên âm + Phát âm) -->
                <div class="card-face card-front shadow-sm">
                    <span class="badge bg-info text-dark mb-2">Mặt trước</span>
                    <h2 id="wordText" class="text-primary display-4 fw-bold mb-1"></h2>
                    <p id="phoneticText" class="text-info fs-5" style="font-family: 'Segoe UI', 'Arial Unicode MS', sans-serif;"></p>
                    <button type="button" id="btnAudio" class="btn btn-outline-primary rounded-pill px-3 mt-2">
                        🔊 Nghe phát âm
                    </button>
                </div>

                <!-- Mặt sau (Nghĩa + Ví dụ) -->
                <div class="card-face card-back shadow-sm">
                    <span class="badge bg-secondary mb-2">Mặt sau</span>
                    <h3 id="meaningText" class="text-success fw-bold mb-2"></h3>
                    <p id="exampleText" class="text-light fst-italic px-3"></p>
                </div>
            </div>
        </div>

        <!-- Thanh điều hướng chuyển từ -->
        <div class="d-flex justify-content-center align-items-center gap-3 mt-4">
            <button type="button" id="btnPrev" class="btn btn-outline-secondary px-4 py-2">⬅ Từ trước</button>
            <span class="fw-bold fs-5 mx-2" id="cardProgress">1 / 1</span>
            <button type="button" id="btnNext" class="btn btn-primary px-4 py-2">Từ tiếp ➡</button>
        </div>
    }
    else
    {
        <div class="alert alert-warning mt-4">Chủ đề này hiện chưa có từ vựng nào trong cơ sở dữ liệu.</div>
    }

    <div class="mt-4">
        <a href="@Url.Action("Index", "Learn")" class="btn btn-secondary">Quay lại danh sách chủ đề</a>
    </div>
</div>

<!-- Đưa dữ liệu JSON vào thuộc tính data của thẻ ẩn để tránh xung đột Razor và TypeScript -->
<div id="vocabDataContainer" data-vocab='@Html.Raw(vocabJson)' style="display:none;"></div>

<!-- CSS cho hiệu ứng lật 3D -->
<style>
    .flashcard-wrapper {
        perspective: 1000px;
        display: flex;
        justify-content: center;
    }

    .flashcard-inner {
        width: 420px;
        max-width: 100%;
        height: 260px;
        position: relative;
        transform-style: preserve-3d;
        transition: transform 0.6s cubic-bezier(0.4, 0.2, 0.2, 1);
        cursor: pointer;
    }

        .flashcard-inner.flipped {
            transform: rotateY(180deg);
        }

    .card-face {
        position: absolute;
        width: 100%;
        height: 100%;
        -webkit-backface-visibility: hidden;
        backface-visibility: hidden;
        border-radius: 15px;
        border: 2px solid #444;
        background-color: #1a1a1a;
        color: #fff;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 20px;
    }

    .card-back {
        background-color: #212529;
        border-color: #555;
        transform: rotateY(180deg);
    }
</style>

<!-- JavaScript xử lý Lật thẻ, Chuyển từ & Phát âm -->
@section Scripts {
    <script>
                document.addEventListener("DOMContentLoaded", function () {
                    const dataEl = document.getElementById('vocabDataContainer');
                    const vocabList = dataEl ? JSON.parse(dataEl.getAttribute('data-vocab') || "[]") : [];
                    let currentIndex = 0;

                    const flashcard = document.getElementById('flashcard');
                    const wordText = document.getElementById('wordText');
                    const phoneticText = document.getElementById('phoneticText');
                    const meaningText = document.getElementById('meaningText');
                    const exampleText = document.getElementById('exampleText');
                    const cardProgress = document.getElementById('cardProgress');
                    const btnAudio = document.getElementById('btnAudio');
                    const btnPrev = document.getElementById('btnPrev');
                    const btnNext = document.getElementById('btnNext');

                    function toggleFlip() {
                        if (flashcard) flashcard.classList.toggle('flipped');
                    }

                    function playAudio() {
                        if (!vocabList || vocabList.length === 0) return;
                        if (!vocabList || vocabList.length === 0) return;

                        window.speechSynthesis.cancel();
                        const word = vocabList[currentIndex].word;
                        if ('speechSynthesis' in window) {
                            const utterance = new SpeechSynthesisUtterance(word);
                            utterance.lang = 'en-US';
                            utterance.rate = 0.9;
                            window.speechSynthesis.speak(utterance);
                        } else {
                            alert("Trình duyệt của bạn không hỗ trợ phát âm.");
                        }
                    }

                    function updateCard() {
                        if (!vocabList || vocabList.length === 0) return;
                        const item = vocabList[currentIndex];

                        if (wordText) wordText.innerText = item.word || "";
                        if (phoneticText) phoneticText.innerText = item.phonetic || "";
                        if (meaningText) meaningText.innerText = item.meaning || "";
                        if (exampleText) exampleText.innerText = item.example ? `"${item.example}"` : "";
                        if (cardProgress) cardProgress.innerText = `${currentIndex + 1} / ${vocabList.length}`;
                        if (flashcard) flashcard.classList.remove('flipped');
                    }

                    function nextCard() {
                        if (!vocabList || vocabList.length === 0) return;
                        currentIndex = (currentIndex + 1) % vocabList.length;
                        updateCard();
                    }

                    function prevCard() {
                        if (!vocabList || vocabList.length === 0) return;
                        currentIndex = (currentIndex - 1 + vocabList.length) % vocabList.length;
                        updateCard();
                    }

                    // Gán sự kiện thay cho inline onclick
                    if (flashcard) flashcard.addEventListener('click', toggleFlip);
                    if (btnAudio) btnAudio.addEventListener('click', playAudio);
                    if (btnPrev) btnPrev.addEventListener('click', prevCard);
                    if (btnNext) btnNext.addEventListener('click', nextCard);

                    if (vocabList && vocabList.length > 0) {
                        updateCard();
                    }
                });
    </script>
}